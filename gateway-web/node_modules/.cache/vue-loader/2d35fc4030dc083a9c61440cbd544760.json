{"remainingRequest":"E:\\前端\\project\\网关\\web\\gateway-web\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!E:\\前端\\project\\网关\\web\\gateway-web\\src\\pages\\authority\\index.vue?vue&type=style&index=1&id=6946a332&lang=scss","dependencies":[{"path":"E:\\前端\\project\\网关\\web\\gateway-web\\src\\pages\\authority\\index.vue","mtime":1713259509758},{"path":"E:\\前端\\project\\网关\\web\\gateway-web\\node_modules\\css-loader\\dist\\cjs.js","mtime":499162500000},{"path":"E:\\前端\\project\\网关\\web\\gateway-web\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":499162500000},{"path":"E:\\前端\\project\\网关\\web\\gateway-web\\node_modules\\postcss-loader\\src\\index.js","mtime":499162500000},{"path":"E:\\前端\\project\\网关\\web\\gateway-web\\node_modules\\sass-loader\\dist\\cjs.js","mtime":499162500000},{"path":"E:\\前端\\project\\网关\\web\\gateway-web\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"E:\\前端\\project\\网关\\web\\gateway-web\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["index.vue"],"names":[],"mappings":";AAqyCA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"index.vue","sourceRoot":"src/pages/authority","sourcesContent":["<template>\r\n  <!-- 权限管理 -->\r\n  <div class=\"authority\">\r\n    <!-- 内容 -->\r\n    <div class=\"table-pannel\">\r\n      <!-- 操作栏 -->\r\n      <div class=\"btn-box\">\r\n        <!-- 按钮 -->\r\n        <div style=\"display: flex\">\r\n          <div class=\"add-btn\" @click=\"addDialog\">\r\n            <div class=\"add-btn-content\">\r\n              <div class=\"add-btn-bg\"></div>\r\n              <div class=\"add-btn-name\">新增</div>\r\n            </div>\r\n          </div>\r\n          <div :class=\"[\r\n              'edit-btn',\r\n              { 'edit-btn-grow': multipleSelection.length > 0 },\r\n            ]\" @click=\"delDialog\">\r\n            <div class=\"add-btn-content\">\r\n              <div class=\"del-btn-bg\"></div>\r\n              <div class=\"edit-btn-name\">删除</div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <!-- 搜索 -->\r\n        <div class=\"border-box-search\">\r\n          <div style=\"\r\n              display: flex;\r\n              transform: skewX(40deg);\r\n              margin-top: 5px;\r\n              z-index: 999;\r\n            \">\r\n            <div class=\"search-input\">\r\n              <el-input v-model=\"keywords\" placeholder=\"请输入URL路径或权限名称搜索\" clearable @keyup.enter.native=\"searchInputFun\" />\r\n            </div>\r\n            <div class=\"search-btn-input\" @click=\"searchInputFun\">\r\n              <i class=\"el-icon-search\"></i>\r\n              搜 索\r\n              <!-- <div class=\"search-btn-bg\"></div> -->\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <!-- 表格数据 -->\r\n      <div class=\"flex-list\">\r\n        <div class=\"main-dataset animated flip\" v-for=\"(item, index) in tableData\" :key=\"item.id\" :style=\"setStyle(index)\">\r\n          <div class=\"dataset-operate\">\r\n            <div class=\"dataset-edit\" @click.stop=\"handleEdit(item)\" v-show=\"item.fixed == 0\">\r\n              <i class=\"el-icon-edit\"></i>\r\n            </div>\r\n            <div class=\"dataset-delete\" @click.stop=\"handleDel(item)\" v-show=\"item.fixed == 0\">\r\n              <i class=\"el-icon-delete\" style=\"padding-left: 8px\"></i>\r\n            </div>\r\n            <div class=\"dataset-delete\" @click.stop=\"handleDetail(item)\">\r\n              <i class=\"el-icon-document\" style=\"padding-left: 8px\"></i>\r\n            </div>\r\n          </div>\r\n          <div class=\"dataset-info ellipsis\">\r\n            <!-- @click.stop=\"activeAuthor($event,item)\" -->\r\n            <div class=\"info-name ellipsis\" :title=\"item.urlName\">{{ item.urlName }}</div>\r\n            <div class=\"info-url\" :title=\"item.url\">{{ item.url }}</div>\r\n            <div class=\"info-open\">\r\n              <template>\r\n                <span v-if=\"item.open == '0'\"> 私有 </span>\r\n                <span v-else-if=\"item.open == '1'\"> 公开 </span>\r\n                <span v-else> 匿名 </span>\r\n              </template>\r\n            </div>\r\n          </div>\r\n          <div class=\"dataset-type\">\r\n            <span class=\"dataset-type-select\" v-show=\"item.fixed == 0\" @click.stop=\"selectData($event, item)\"></span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"pagination\">\r\n        <el-pagination @size-change=\"handleSizeChange\" @current-change=\"handleCurrentChange\" :current-page.sync=\"pageNum\" background :page-size=\"pageSize\" layout=\"total, prev, pager, next\" :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 添加 修改 -->\r\n    <el-dialog v-drag :title=\"title\" :visible.sync=\"add\" :before-close=\"handleClose\" width=\"600px\" append-to-body>\r\n      <el-form ref=\"form\" :model=\"addForm\" :rules=\"addrules\" label-width=\"80px\">\r\n        <el-row>\r\n          <el-col :span=\"12\">\r\n            <el-form-item label=\"权限名称\" prop=\"urlName\">\r\n              <el-input v-model=\"addForm.urlName\" :disabled=\"!edit\" placeholder=\"请输入权限名称\" />\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :span=\"12\">\r\n            <el-form-item label=\"URL路径\" prop=\"url\">\r\n              <el-input v-model=\"addForm.url\" :disabled=\"!edit\" placeholder=\"请输入URL路径\" />\r\n            </el-form-item>\r\n          </el-col>\r\n        </el-row>\r\n        <el-row class=\"special-row\">\r\n          <el-col :span=\"24\">\r\n            <el-form-item label=\"是否公开\" style=\"margin-bottom: 5px\">\r\n              <el-select v-model=\"addForm.open\" :disabled=\"!edit\" placeholder=\"请选择是否公开\" style=\"width: 100%\">\r\n                <el-option v-for=\"item in dictOptions\" :key=\"item.id.toString()\" :label=\"item.dictName\" :value=\"item.dictVal\"></el-option>\r\n              </el-select>\r\n            </el-form-item>\r\n            <ul class=\"desc-list\">\r\n              <li>1、私有：登录后需要为角色分配权限</li>\r\n              <li>2、公开：登录后无需为角色分配权限</li>\r\n              <li>3、匿名：无需登录</li>\r\n            </ul>\r\n          </el-col>\r\n        </el-row>\r\n        <el-row> </el-row>\r\n        <el-row>\r\n          <el-col :span=\"24\">\r\n            <el-form-item label=\"角色选择\">\r\n              <el-select v-model=\"addForm.roleInfos\" placeholder=\"请选择角色\" multiple=\"\" :disabled=\"addForm.open == '1' || addForm.open == '2' || !edit\" clearable style=\"width: 100%\">\r\n                <el-option v-for=\"item in roleOptions\" :key=\"item.id.toString()\" :label=\"item.roleName\" :value=\"item.id.toString()\"></el-option>\r\n              </el-select>\r\n            </el-form-item>\r\n          </el-col>\r\n        </el-row>\r\n        <el-row>\r\n          <el-col :span=\"24\">\r\n            <el-form-item label=\"描述\">\r\n              <el-input v-model=\"addForm.description\" :disabled=\"!edit\" type=\"textarea\" placeholder=\"请输入内容\"></el-input>\r\n            </el-form-item>\r\n          </el-col>\r\n        </el-row>\r\n      </el-form>\r\n      <div slot=\"footer\" class=\"dialog-footer\" v-show=\"edit\">\r\n        <el-button type=\"primary\" @click=\"addSubmit\" class=\"confirm-btn\">确 定</el-button>\r\n        <el-button @click=\"addCancel\">取 消</el-button>\r\n      </div>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n// 头部\r\n// tab切换\r\n// import {beginLine} from '../../plugins/canvasLine.js';\r\nexport default {\r\n  components: {},\r\n  data() {\r\n    return {\r\n      roleTabShow: \"-350\",\r\n      jsId: \"\",\r\n      file: null,\r\n      questionObject: {\r\n        // questionsNmae: '',\r\n        file: null,\r\n      },\r\n      questionIds: [],\r\n      formLabelWidth: \"120px\",\r\n      fileList: [{ name: undefined }],\r\n      templateShow: false,\r\n      username: \"\",\r\n      tel: \"\",\r\n      dataStatus: \"\",\r\n      pageSize: 10,\r\n      pageNum: 0,\r\n      pageSize2: 10,\r\n      pageNum2: 0,\r\n      total: 0,\r\n      time: [\"\", \"\"],\r\n      tableData: [],\r\n      tableData2: [],\r\n      multipleSelection: [],\r\n      switchStatus: \"0\",\r\n      currentPage: 5,\r\n      add: false,\r\n      // 表单校验\r\n      addrules: {\r\n        urlName: [\r\n          { required: true, message: \"权限名称不能为空\", trigger: \"blur\" },\r\n        ],\r\n        url: [{ required: true, message: \"URL路径不能为空\", trigger: \"blur\" }],\r\n      },\r\n      addForm: {\r\n        urlName: \"\",\r\n        url: \"\",\r\n        open: \"0\",\r\n        description: \"\",\r\n        roleInfos: [],\r\n      },\r\n      title: \"\",\r\n      // 部门树选项\r\n      deptOptions: undefined,\r\n      // 性别状态字典\r\n      //修改\r\n      // 状态数据字典\r\n      statusOptions: [],\r\n      // 岗位选项\r\n      postOptions: [],\r\n      // 角色选项\r\n      roleOptions: [],\r\n      edit: false,\r\n\r\n      editForm: {\r\n        urlName: \"\",\r\n        url: \"\",\r\n        open: \"0\",\r\n        description: \"\",\r\n        roleInfos: [],\r\n        id: \"\",\r\n      },\r\n      editRoleForm: {\r\n        permissionInfos: [],\r\n      },\r\n\r\n      resetFlag: false,\r\n      resetForm: {\r\n        password: \"\",\r\n      },\r\n      editRole: false,\r\n      activeRole: {},\r\n      dictOptions: [],\r\n      keywords: \"\",\r\n      keywords2: \"\",\r\n      edit: true,\r\n    };\r\n  },\r\n  mounted() {\r\n    // this.canvas();\r\n    this.searchFn();\r\n    // this.searchFn2()\r\n    this.getRoles();\r\n    this.queryDictByDictTypeId();\r\n  },\r\n  methods: {\r\n    selectData(e, data) {\r\n      if (data.fixed != 0) {\r\n        return;\r\n      }\r\n      let classNames = e.target.parentElement.className;\r\n      if (classNames.indexOf(\"dataset-type-select\") == -1) {\r\n        e.target.parentElement.className = \"dataset-type dataset-type-select\";\r\n        this.multipleSelection.push(data);\r\n      } else {\r\n        e.target.parentElement.className = \"dataset-type\";\r\n        this.multipleSelection = this.multipleSelection.filter(function (item) {\r\n          return item.id !== data.id;\r\n        });\r\n      }\r\n    },\r\n    activeAuthor(e, item) {\r\n      let classNames = e.currentTarget.parentElement.className;\r\n      if (classNames.indexOf(\"dataset-type-active\") == -1) {\r\n        e.currentTarget.parentElement.className =\r\n          \"main-dataset animated flip dataset-type-active\";\r\n      } else {\r\n        e.currentTarget.parentElement.className = \"main-dataset animated flip\";\r\n      }\r\n    },\r\n    canvas() {\r\n      //beginLine('myCanvas')\r\n    },\r\n    setStyle(index) {\r\n      if (index < 10) {\r\n        return { \"animation-delay\": \"0.\" + index + \"s\" };\r\n      } else {\r\n        return { \"animation-delay\": index * 0.1 + \"s\" };\r\n      }\r\n    },\r\n    handleClose() {\r\n      this.$refs[\"form\"].resetFields();\r\n      this.add = false;\r\n    },\r\n    handleSelectionChange(val) {\r\n      this.multipleSelection = val;\r\n    },\r\n    //点击行触发，选中或不选中复选框\r\n    handleRowClick(row) {\r\n      this.$refs.multipleTable.toggleRowSelection(row);\r\n      // 获取当前选中的数据\r\n      const _selectData = this.$refs.multipleTable.selection;\r\n      console.log(\"当前选中的数据\", _selectData);\r\n      this.handleSelectionChange(_selectData);\r\n    },\r\n    queryDictByDictTypeId() {\r\n      this.$get(\r\n        $url.DATA_URL + \"/gateway/queryDictByDictTypeId?dictTypeId=1\"\r\n      ).then((res) => {\r\n        if (res.data.code == 200) {\r\n          this.dictOptions = res.data.data;\r\n        } else {\r\n          this.$router.push(\"/\");\r\n          // this.$message({\r\n          //   type: \"error\",\r\n          //   message: res.data.msg\r\n          // });\r\n        }\r\n      });\r\n    },\r\n    queryPermissionByRoleId() {\r\n      this.$get(\r\n        $url.DATA_URL +\r\n          \"/gateway/queryPermissionsByRoleId?roleId=\" +\r\n          this.activeRole.id\r\n      ).then((res) => {\r\n        if (res.data.code == 200) {\r\n          this.editRoleForm.permissionInfos = [];\r\n          for (let i = 0; i < res.data.data.length; i++) {\r\n            this.editRoleForm.permissionInfos.push(\r\n              res.data.data[i].id.toString()\r\n            );\r\n          }\r\n        } else {\r\n          this.$message({\r\n            type: \"error\",\r\n            message: res.data.msg,\r\n          });\r\n        }\r\n      });\r\n    },\r\n\r\n    handleSelectionChange(val) {\r\n      this.multipleSelection = val;\r\n    },\r\n    handleEdit(row) {\r\n      this.title = \"修改权限\";\r\n      this.add = true;\r\n      this.edit = true;\r\n      this.addForm.urlName = row.urlName;\r\n      this.addForm.open = row.open.toString();\r\n      this.addForm.url = row.url;\r\n      this.addForm.description = row.description;\r\n      this.addForm.roleInfos = [];\r\n      for (let i = 0; i < row.roleInfos.length; i++) {\r\n        this.addForm.roleInfos.push(row.roleInfos[i].id);\r\n      }\r\n      this.addForm.id = row.id;\r\n    },\r\n    handleDetail(row) {\r\n      this.title = \"权限详情\";\r\n      this.add = true;\r\n      this.edit = false;\r\n      this.addForm.urlName = row.urlName;\r\n      this.addForm.open = row.open.toString();\r\n      this.addForm.url = row.url;\r\n      this.addForm.description = row.description;\r\n      this.addForm.roleInfos = [];\r\n      for (let i = 0; i < row.roleInfos.length; i++) {\r\n        this.addForm.roleInfos.push(row.roleInfos[i].id);\r\n      }\r\n      this.addForm.id = row.id;\r\n    },\r\n\r\n    handleSizeChange(val) {\r\n      this.pageSize = val;\r\n      // this.getUserList()\r\n      this.searchFn();\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.pageNum = val;\r\n      // this.getUserList()\r\n      this.searchFn();\r\n    },\r\n    handleSelectChange() {},\r\n    addDialog() {\r\n      this.addForm = {\r\n        urlName: \"\",\r\n        url: \"\",\r\n        open: \"0\",\r\n        description: \"\",\r\n        roleInfos: [],\r\n      };\r\n      this.title = \"新增权限\";\r\n      this.edit = true;\r\n      this.add = true;\r\n      //this.getTreeselect()\r\n    },\r\n    getRoles() {\r\n      this.$get($url.DATA_URL + \"/gateway/queryAllRoles\").then((res) => {\r\n        if (res.data.code == 200) {\r\n          this.roleOptions = res.data.data;\r\n        } else {\r\n          this.$router.push(\"/login\");\r\n          // this.$message({\r\n          //   type: \"error\",\r\n          //   message: res.data.msg\r\n          // });\r\n        }\r\n      });\r\n    },\r\n    //新增确认按钮\r\n    addSubmit() {\r\n      if (!this.edit) {\r\n        return;\r\n      }\r\n      let url = \"/gateway/addPermission\";\r\n      if (this.addForm.id) {\r\n        url = \"/gateway/updatePermission\";\r\n      }\r\n      this.$refs[\"form\"].validate((valid) => {\r\n        if (valid) {\r\n          if (this.addForm.open == \"0\" && this.addForm.roleInfos.length == 0) {\r\n            this.$message.warning(\"请选择角色!\");\r\n            return;\r\n          }\r\n\r\n          let roleArr = [];\r\n          for (let i = 0; i < this.roleOptions.length; i++) {\r\n            if (this.addForm.roleInfos.indexOf(this.roleOptions[i].id) != -1) {\r\n              roleArr.push(this.roleOptions[i]);\r\n            }\r\n          }\r\n          this.addForm.roleInfos = roleArr;\r\n          this.$post($url.DATA_URL + url, this.addForm).then((res) => {\r\n            if (res.data.code == 200) {\r\n              this.add = false;\r\n              this.$message({\r\n                type: \"success\",\r\n                message: this.title + res.data.msg,\r\n              });\r\n              // this.getUserList();\r\n              this.searchFn();\r\n            } else {\r\n              this.$message({\r\n                type: \"error\",\r\n                message: res.data.msg,\r\n              });\r\n            }\r\n          });\r\n        } else {\r\n          this.add = true;\r\n        }\r\n      });\r\n    },\r\n    addCancel() {\r\n      this.$refs[\"form\"].resetFields();\r\n      this.add = false;\r\n    },\r\n    handleDel(row) {\r\n      this.$confirm(\"此操作将永久删除该条权限信息, 是否继续?\", \"提示\", {\r\n        confirmButtonText: \"确定\",\r\n        cancelButtonText: \"取消\",\r\n        type: \"warning\",\r\n      }).then(() => {\r\n        this.$get($url.DATA_URL + \"/gateway/delPermission?id=\" + row.id).then(\r\n          (res) => {\r\n            if (res.data.code == 200) {\r\n              this.$message({\r\n                type: \"success\",\r\n                message: \"删除成功!\",\r\n              });\r\n              this.searchFn();\r\n            } else {\r\n              this.$message({\r\n                type: \"error\",\r\n                message: res.data.msg,\r\n              });\r\n            }\r\n          }\r\n        );\r\n      });\r\n      // this.$delete( `/onlineteaching/user/${row.id}`).then((res) => {\r\n      //   this.getUserList()\r\n      // })\r\n    },\r\n    delDialog() {\r\n      if (this.multipleSelection.length < 1) {\r\n        return this.$message({\r\n          type: \"error\",\r\n          message: \"请至少选择一条数据\",\r\n        });\r\n      }\r\n      let that = this;\r\n      this.$confirm(\"此操作将永久删除数据, 是否继续?\", \"提示\", {\r\n        confirmButtonText: \"确定\",\r\n        cancelButtonText: \"取消\",\r\n        type: \"warning\",\r\n      }).then(() => {\r\n        let ids = \"\";\r\n        for (let i = 0; i < that.multipleSelection.length; i++) {\r\n          if (i == that.multipleSelection.length - 1) {\r\n            ids += that.multipleSelection[i].id.toString();\r\n          } else {\r\n            ids += that.multipleSelection[i].id.toString() + \",\";\r\n          }\r\n        }\r\n        this.$get($url.DATA_URL + \"/gateway/delPermissions?ids=\" + ids).then(\r\n          (res) => {\r\n            if (res.data.code == 200) {\r\n              this.$message({\r\n                type: \"success\",\r\n                message: \"删除成功!\",\r\n              });\r\n              this.multipleSelection = [];\r\n              this.searchFn();\r\n            } else {\r\n              this.$message({\r\n                type: \"error\",\r\n                message: res.data.msg,\r\n              });\r\n            }\r\n          }\r\n        );\r\n      });\r\n    },\r\n    searchInputFun() {\r\n      this.pageNum = 1;\r\n      this.searchFn();\r\n    },\r\n\r\n    searchFn() {\r\n      this.multipleSelection = [];\r\n      //   \"dataset-type dataset-type-select\"\r\n      let doms = document.getElementsByClassName(\"dataset-type\");\r\n      for (let i = 0; i < doms.length; i++) {\r\n        if (doms[i].className.includes(\"dataset-type-select\")) {\r\n          doms[i].className = \"dataset-type\";\r\n        }\r\n      }\r\n      if (!this.cookie.getCookie(\"username\")) {\r\n        this.$router.push(\"/login\");\r\n      }\r\n      this.$get(\r\n        $url.DATA_URL +\r\n          \"/gateway/queryPermission?keywords=\" +\r\n          this.keywords +\r\n          \"&current=\" +\r\n          this.pageNum +\r\n          \"&size=\" +\r\n          this.pageSize\r\n      ).then((res) => {\r\n        if (res.data.code === 200) {\r\n          this.tableData = res.data.data.records;\r\n          this.total = res.data.data.total;\r\n        } else {\r\n          this.$message({\r\n            type: \"error\",\r\n            message: res.data.msg,\r\n          });\r\n          this.$router.push(\"/l